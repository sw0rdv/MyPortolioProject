@model MyPortolioProject.DAL.Entity.Portfolio
@{
    ViewData["Title"] = "Proje Ekle";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Portfolyo</h4>
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Yeni Proje Ekle</div>
                    </div>
                    <form method="post" asp-action="CreatePortfolio">
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Title">Proje Adı</label>
                                <input type="text" asp-for="Title" class="form-control" placeholder="Örn: EH Trendyol Takip" />
                            </div>
                            <div class="form-group">
                                <label asp-for="SubTitle">Alt Başlık</label>
                                <input type="text" asp-for="SubTitle" class="form-control" placeholder="Örn: ASP.NET Core / Fiyat Takip Sistemi" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Görsel URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            </div>
                            <div class="form-group">
                                <label asp-for="Url">Proje Bağlantısı</label>
                                <input type="url" asp-for="Url" class="form-control" placeholder="https://github.com/..." />
                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-success"><i class="la la-check"></i> Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>