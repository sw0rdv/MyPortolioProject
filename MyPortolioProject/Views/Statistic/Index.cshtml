@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Dashboard</h4>

        <div class="row">
            <div class="col-md-3">
                <div class="card card-stats card-primary">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center"><i class="la la-briefcase"></i></div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Deneyimler</p>
                                    <h4 class="card-title">@(ViewBag.ExperienceCount ?? 0)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-stats card-success">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center"><i class="la la-code"></i></div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Yetenekler</p>
                                    <h4 class="card-title">@(ViewBag.SkillCount ?? 0)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-stats card-warning">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center"><i class="la la-folder-open"></i></div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Projeler</p>
                                    <h4 class="card-title">@(ViewBag.PortfolioCount ?? 0)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-stats card-info">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center"><i class="la la-quote-left"></i></div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Referanslar</p>
                                    <h4 class="card-title">@(ViewBag.TestimonialCount ?? 0)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="card card-stats card-danger">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center"><i class="la la-envelope"></i></div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Gelen Mesajlar</p>
                                    <h4 class="card-title">@(ViewBag.MessageCount ?? 0)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

                <div class="col-md-3">
                    <div class="card card-stats card-warning">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-5">
                                    <div class="icon-big text-center"><i class="la la-envelope"></i></div>
                                </div>
                                <div class="col-7 d-flex align-items-center">
                                    <div class="numbers">
                                        <p class="card-category">Okunmamış Mesajlar</p>
                                        <h4 class="card-title">@(ViewBag.MessageCountV2 ?? 0)</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            <div class="col-md-3">
                <div class="card card-stats card-primary">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center"><i class="la la-share-alt"></i></div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Sosyal Medya</p>
                                    <h4 class="card-title">@(ViewBag.SocialMediaCount ?? 0)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-stats card-warning">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center"><i class="la la-star"></i></div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Öne Çıkanlar</p>
                                    <h4 class="card-title">@(ViewBag.FeatureCount ?? 0)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            
        </div>

    </div>
</div>