@model MyPortolioProject.DAL.Entitiy.ToDoList
@{
    ViewData["Title"] = "ToDoList";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Yapılacaklar</h4>
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Yeni Görev Ekle</div>
                    </div>
                    <form method="post" asp-action="AddToDoList">
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Title">Görev Başlığı</label>
                                <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Portfolyo sayfasını güncelle" />
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Görsel URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            </div>
                            <div class="form-group">
                                <label asp-for="Date">Tarih</label>
                                <input type="date" asp-for="Date" class="form-control" />
                            </div>
                            <div class="form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" type="checkbox" asp-for="Status" />
                                    <span class="form-check-sign">Tamamlandı</span>
                                </label>
                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-success"><i class="la la-check"></i> Kaydet</button>
                            <a asp-action="Index" class="btn btn-danger"><i class="la la-times"></i> Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>