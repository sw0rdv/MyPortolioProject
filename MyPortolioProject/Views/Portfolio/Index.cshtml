@model List<MyPortolioProject.DAL.Entity.Portfolio>
@{
    ViewData["Title"] = "Portfolyo";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Portfolyo</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Proje Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Portfolyo projelerinizi bu panelden yönetebilirsiniz.
                        </div>
                        <table class="table table-hover mt-3">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Görsel</th>
                                    <th>Proje</th>
                                    <th>Alt Başlık</th>
                                    <th>Bağlantı</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" style="width:60px;height:40px;object-fit:cover;border-radius:6px;" />
                                            }
                                        </td>
                                        <td>@item.Title</td>
                                        <td>@item.SubTitle</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Url))
                                            {
                                                <a href="@item.Url" target="_blank" class="btn btn-info btn-sm"><i class="la la-external-link"></i> Aç</a>
                                            }
                                        </td>
                                        <td><a href="/Portfolio/DeletePortfolio/@item.PortfolioId" class="btn btn-danger btn-sm" onclick="return confirm('Bu projeyi silmek istediğine emin misin?')">Sil</a></td>
                                        <td><a href="/Portfolio/UpdatePortfolio/@item.PortfolioId" class="btn btn-success btn-sm">Güncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/Portfolio/CreatePortfolio" class="btn btn-primary"><i class="la la-plus"></i> Yeni Proje Ekle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>