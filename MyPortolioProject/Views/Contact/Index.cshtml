@model MyPortolioProject.DAL.Entity.Contact

@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">İletişim Bilgileri Güncelleme</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">İletişim Alanı Düzenleme Formu</div>
                    </div>
                    <div class="card-body">

                        <form method="post">
                            <input type="hidden" asp-for="ContactId" />

                            <div class="form-group mb-3">
                                <label>Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>

                            <div class="form-group mb-3">
                                <label>Açıklama (Lead Yazısı)</label>
                                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label>Telefon 1</label>
                                    <input type="text" asp-for="Phone1" class="form-control" />
                                </div>
                                <div class="col-md-6 form-group mb-3">
                                    <label>Telefon 2</label>
                                    <input type="text" asp-for="Phone2" class="form-control" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label>Email 1</label>
                                    <input type="email" asp-for="Email1" class="form-control" />
                                </div>
                                <div class="col-md-6 form-group mb-3">
                                    <label>Email 2</label>
                                    <input type="email" asp-for="Email2" class="form-control" />
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label>Adres</label>
                                <input type="text" asp-for="Adress" class="form-control" />
                            </div>

                            <button type="submit" class="btn btn-primary">Bilgileri Güncelle</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>