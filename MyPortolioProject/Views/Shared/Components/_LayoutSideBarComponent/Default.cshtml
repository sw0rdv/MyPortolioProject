<div class="sidebar">
    <div class="scrollbar-inner sidebar-wrapper">
        <div class="user">
            <div class="photo">
                <img src="~/Ready-Bootstrap-Dashboard-master/assets/img/profile.jpg">
            </div>
            <div class="info">
                <a class="" data-toggle="collapse" href="#collapseExample" aria-expanded="true">
                    <span>
                        Özgür Nuri VURAL
                        <span class="user-level">Administrator</span>
                        <span class="caret"></span>
                    </span>
                </a>
                <div class="clearfix"></div>

                <div class="collapse in" id="collapseExample" aria-expanded="true" style="">
                    <ul class="nav">
                        <li>
                            <a href="#profile">
                                <span class="link-collapse">Profilim</span>
                            </a>
                        </li>
                        <li>
                            <a href="#edit">
                                <span class="link-collapse">Şifre Değiştir</span>
                            </a>
                        </li>
                        <li>
                            <a href="#settings">
                                <span class="link-collapse">Ayarlar</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            Func<string, string> Active = name => currentController == name ? "active" : "";
        }

        <ul class="nav">
            <li class="nav-item @Active("Statistic")">
                <a href="/Statistic/Index">
                    <i class="la la-dashboard"></i>
                    <p>Dashboard</p>
                </a>
            </li>

            <li class="nav-item @Active("About")">
                <a href="/About/Index">
                    <i class="la la-user"></i>
                    <p>Hakkımda</p>
                </a>
            </li>
            <li class="nav-item @Active("Experience")">
                <a href="/Experience/ExperienceList">
                    <i class="la la-briefcase"></i>
                    <p>Deneyimler</p>
                </a>
            </li>
            <li class="nav-item @Active("Abilities")">
                <a href="/Abilities/Index">
                    <i class="la la-code"></i>
                    <p>Yetenekler</p>
                </a>
            </li>
            <li class="nav-item @Active("Portfolio")">
                <a href="/Portfolio/Index">
                    <i class="la la-folder-open"></i>
                    <p>Portfolyo</p>
                </a>
            </li>
            <li class="nav-item @Active("ToDoList")">
                <a href="/ToDoList/Index">
                    <i class="la la-check-square"></i>
                    <p>Yapılacaklar</p>
                </a>
            </li>
            <li class="nav-item @Active("Contact")">
                <a href="/Contact/Index">
                    <i class="la la-phone"></i>
                    <p>İletişim Bilgileri</p>
                </a>
            </li>
            <li class="nav-item @Active("SocialMedia")">
                <a href="/SocialMedia/Index">
                    <i class="la la-share-alt"></i>
                    <p>Sosyal Medya</p>
                </a>
            </li>
            <li class="nav-item @Active("Message")">
                <a href="/Message/Inbox">
                    <i class="la la-envelope"></i>
                    <p>Mesaj Kutusu</p>
                </a>
            </li>

            <li class="nav-item">
                <a href="/Default/Index" target="_blank">
                    <i class="la la-globe"></i>
                    <p>Siteye Git</p>
                </a>
            </li>
            <li class="nav-item">
                <a href="/Login/Logout">
                    <i class="la la-sign-out"></i>
                    <p>Çıkış Yap</p>
                </a>
            </li>
        </ul>
    </div>
</div>