@model MyPortolioProject.DAL.Entity.Portfolio
@{
    ViewData["Title"] = "Proje Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Portfolyo</h4>
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Projeyi Güncelle</div>
                    </div>
                    <form method="post" asp-action="UpdatePortfolio">
                        <input type="hidden" asp-for="PortfolioId" />
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Title">Proje Adı</label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="SubTitle">Alt Başlık</label>
                                <input type="text" asp-for="SubTitle" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Görsel URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" />
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" class="mt-2" style="max-width:200px;border-radius:6px;" />
                                }
                            </div>
                            <div class="form-group">
                                <label asp-for="Url">Proje Bağlantısı</label>
                                <input type="url" asp-for="Url" class="form-control" />
                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-warning"><i class="la la-refresh"></i> Güncelle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>