@model List<MyPortolioProject.DAL.Entity.Skill>
@{
    ViewData["Title"] = "Yetenekler";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Yetenekler</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Yetenek Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Yetenekler ile ilgili işlemleri bu panelden yapabilirsiniz.
                        </div>
                        <table class="table table-hover mt-3">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Yetenek</th>
                                    <th style="width:40%">Seviye</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.SkillTitle</td>
                                        <td>
                                            <div class="progress" style="height:20px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width:@(item.Value)%">
                                                    %@item.Value
                                                </div>
                                            </div>
                                        </td>
                                        <td><a href="/Abilities/DeleteSkill/@item.SkillId" class="btn btn-danger btn-sm" onclick="return confirm('Bu yeteneği silmek istediğine emin misin?')">Sil</a></td>
                                        <td><a href="/Abilities/UpdateSkill/@item.SkillId" class="btn btn-success btn-sm">Güncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/Abilities/AddSkill" class="btn btn-primary"><i class="la la-plus"></i> Yeni Yetenek Ekle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>