@model MyPortolioProject.DAL.Entity.Skill
@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Yetenekler</h4>
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Yeteneği Güncelle</div>
                    </div>
                    <form method="post" asp-action="UpdateSkill">
                        <input type="hidden" asp-for="SkillId" />
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="SkillTitle">Yetenek Adı</label>
                                <input type="text" asp-for="SkillTitle" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Value">Seviye (%)</label>
                                <input type="number" asp-for="Value" class="form-control" min="0" max="100" />
                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-warning"><i class="la la-refresh"></i> Güncelle</button>
                            <a asp-action="Index" class="btn btn-danger"><i class="la la-times"></i> Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>