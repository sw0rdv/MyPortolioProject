@model List<MyPortolioProject.DAL.Entitiy.ToDoList>
@{
    ViewData["Title"] = "Yapılacaklar";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Yapılacaklar</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Görev Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Yapılacaklar ile ilgili işlemleri bu panelden yapabilirsiniz.
                        </div>
                        <table class="table table-hover mt-3">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Görev</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                    <th>İşlem</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>
                                            @if (item.Status)
                                            {
                                                <s class="text-muted">@item.Title</s>
                                            }
                                            else
                                            {
                                                @item.Title
                                            }
                                        </td>
                                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (item.Status == true)
                                            {
                                               <td><a href="/ToDoList/ChangeStatusFalse/@item.ToDoListID" class="btn btn-dark btn-sm">Yapılmadı Olarak İşaretle</a></td>
                                            }
                                            else
                                            {
                                            <td><a href="/ToDoList/ChangeStatusTrue/@item.ToDoListID" class="btn btn-dark btn-sm">Yapıldı Olarak İşaretle</a></td>
                                        }
                                        
                                        <td>
                                            @if (item.Status)
                                            {
                                                <a href="/ToDoList/ChangeStatusFalse/@item.ToDoListID" class="btn btn-dark btn-sm">Geri Al</a>
                                            }
                                            else
                                            {
                                                <a href="/ToDoList/ChangeStatusTrue/@item.ToDoListID" class="btn btn-info btn-sm">Tamamlandı Yap</a>
                                            }
                                        </td>
                                        <td><a href="/ToDoList/DeleteToDoList/@item.ToDoListID" class="btn btn-danger btn-sm" onclick="return confirm('Bu görevi silmek istediğine emin misin?')">Sil</a></td>
                                        <td><a href="/ToDoList/UpdateToDoList/@item.ToDoListID" class="btn btn-success btn-sm">Güncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/ToDoList/AddToDoList" class="btn btn-primary"><i class="la la-plus"></i> Yeni Görev Ekle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>