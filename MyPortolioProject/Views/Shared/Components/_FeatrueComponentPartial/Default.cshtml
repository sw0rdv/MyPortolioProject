@model List<MyPortolioProject.DAL.Entity.Feature>

<section id="home" class="s-home page-hero target-section" data-parallax="scroll" data-image-src="@(string.IsNullOrWhiteSpace(ViewBag.HeroImageUrl) ? "https://i.ibb.co/tMm6BRHf/Whats-App-mage-2026-11-10-at-01-22-12.jpg" : ViewBag.HeroImageUrl)" data-natural-width="3000" data-natural-height="2000" data-position-y="center">

    <div class="overlay"></div>
    <div class="shadow-overlay"></div>

    @foreach(var item in Model)
    {
        <div class="home-content">

        <div class="row home-content__main">

            <h3>@item.Title</h3>

            <h1>
               @item.Description
            </h1>

            <div class="home-content__buttons">
                <a href="#works" class="smoothscroll btn btn--stroke">
                    Son Projelerim
                </a>
                <a href="#about" class="smoothscroll btn btn--stroke">
                    Hakkımda
                </a>
            </div>

            <div class="home-content__scroll">
                <a href="#about" class="scroll-link smoothscroll">
                    <span>Aşağı Kaydır</span>
                </a>
            </div>

        </div>
        </div>
    }


</section>