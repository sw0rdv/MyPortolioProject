@model IEnumerable<MyPortolioProject.DAL.Entity.Portfolio>

<section id="works" class="s-works target-section">
    <div class="row narrow section-intro has-bottom-sep">
        <div class="col-full">
            <h3>Portfolyo</h3>
            <h1>Son Projelerime Göz Atabilirsiniz.</h1>
            <p class="lead">Projelerimi ve çalışmalarımı aşağıdan inceleyebilirsiniz.</p>
        </div>
    </div>

    <div class="row masonry-wrap">
        <div class="masonry">
            @foreach (var portfolio in Model)
            {
                <div class="masonry__brick">
                    <div class="item-folio">
                        @if (!string.IsNullOrWhiteSpace(portfolio.ImageUrl))
                        {
                            <div class="item-folio__thumb">
                                <a href="@Url.Content(portfolio.ImageUrl)" class="thumb-link" title="@portfolio.Title" data-size="1050x700">
                                    <img src="@Url.Content(portfolio.ImageUrl)" alt="@portfolio.Title">
                                    <span class="shadow-overlay"></span>
                                </a>
                            </div>
                        }

                        <div class="item-folio__text">
                            <h3 class="item-folio__title">@portfolio.Title</h3>
                            <p class="item-folio__cat">@portfolio.SubTitle</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(portfolio.Url))
                        {
                            <a href="@portfolio.Url" class="item-folio__project-link" title="Projeyi görüntüle" target="_blank" rel="noopener noreferrer">
                                <i class="im im-link"></i>
                            </a>
                        }

                        <span class="item-folio__caption">
                            <p>@portfolio.Description</p>
                        </span>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <p>Henüz portfolyo projesi eklenmemiş.</p>
            }
        </div>
    </div>
</section>