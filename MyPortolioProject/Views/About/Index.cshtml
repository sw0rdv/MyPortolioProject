@model MyPortolioProject.DAL.Entity.About
@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Hakkımda</h4>
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Kaydı Güncelle</div>
                    </div>
                    <form method="post" asp-action="Index">
                        <input type="hidden" asp-for="AboutID" />
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Title">Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="SubDescription">Kısa Açıklama</label>
                                <input type="text" asp-for="SubDescription" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Details">Detay</label>
                                <textarea asp-for="Details" class="form-control" rows="6"></textarea>
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Hakkımda Görseli</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="/hola-master/images/hero-bg.jpg" />
                                <small class="form-text text-muted">Örnek: /hola-master/images/hero-bg.jpg</small>
                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-warning"><i class="la la-refresh"></i> Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>